# Copia este archivo como .env y pon los valores de tu proyecto.
# Están en Supabase: Project Settings > API (o Data API).
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-anon-key

# Ingreso con Google: ID de cliente tipo "Aplicación web" de Google Cloud
# (Credenciales). Termina en .apps.googleusercontent.com. Ver docs/GOOGLE.md
GOOGLE_WEB_CLIENT_ID=
