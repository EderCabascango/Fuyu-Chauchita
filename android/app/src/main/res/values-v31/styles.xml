<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: pantalla de inicio del sistema en blanco cálido con el ícono de la app. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/fondo_inicio</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/fondo_inicio</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
