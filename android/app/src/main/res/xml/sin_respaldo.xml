<?xml version="1.0" encoding="utf-8"?>
<!-- No copiar los datos de la app (incluida la sesión) a respaldos en la nube
     ni al pasar a otro teléfono: así nadie puede reutilizar la sesión. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
